<?xml version="1.0" encoding="UTF-8"?>
<!--
	WPML configuration for WDOD Starter.
	https://wpml.org/documentation/support/language-configuration-files/
-->
<wpml-config>
	<custom-fields>
		<!-- WDOD Hero block -->
		<custom-field action="translate">eyebrow</custom-field>
		<custom-field action="translate">heading</custom-field>
		<custom-field action="translate">text</custom-field>
		<custom-field action="translate">button</custom-field>
		<custom-field action="copy">background_image</custom-field>
		<custom-field action="copy">overlay_opacity</custom-field>

		<!-- WDOD Testimonials block (repeater rows are stored as items_0_quote etc.) -->
		<custom-field action="copy">items</custom-field>
		<custom-field action="translate">items_*_quote</custom-field>
		<custom-field action="translate">items_*_author</custom-field>
		<custom-field action="translate">items_*_role</custom-field>
		<custom-field action="copy">items_*_avatar</custom-field>
	</custom-fields>

	<custom-types>
	</custom-types>

	<taxonomies>
	</taxonomies>

	<admin-texts>
		<!-- ACF options page values (stored as options_<field>). -->
		<key name="options_footer_text" />
		<key name="options_phone" />
		<key name="options_email" />
		<key name="options_social">
			<key name="*">
				<key name="network" />
				<key name="url" />
			</key>
		</key>
	</admin-texts>

	<gutenberg-blocks>
		<gutenberg-block type="wdod/hero" translate="1">
			<key name="data">
				<key name="eyebrow" />
				<key name="heading" />
				<key name="text" />
				<key name="button">
					<key name="title" />
					<key name="url" />
				</key>
			</key>
		</gutenberg-block>
		<gutenberg-block type="wdod/testimonials" translate="1">
			<key name="data">
				<key name="heading" />
			</key>
		</gutenberg-block>
	</gutenberg-blocks>

	<elementor-widgets>
	</elementor-widgets>
</wpml-config>
