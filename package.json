{
	"name": "wdod-starter",
	"version": "1.0.0",
	"private": true,
	"description": "Build tooling for the WDOD Starter WordPress theme.",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"dev": "vite build --watch",
		"build": "vite build",
